# --- vendored source tree (src/itlwm) ---
# The upstream C++ template patterns above swallow files that the itlwm
# build genuinely needs. Re-include them.
!src/itlwm/itlwm/*.pch
!src/itlwm/MacKernelSDK/**/*.a
!src/itlwm/MacKernelSDK/**/Makefile
